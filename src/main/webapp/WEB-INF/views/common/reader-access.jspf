<%@ page pageEncoding="UTF-8" import="vn.edu.library.model.Member2,vn.edu.library.dao.MemberDAO,java.sql.SQLException" %>
<%
    response.setHeader("Cache-Control", "no-store");
    Member2 signedInReader = (Member2) session.getAttribute("signedInMember");
    if (signedInReader == null) {
        if ("GET".equals(request.getMethod()) || "HEAD".equals(request.getMethod()))
            response.sendRedirect(request.getContextPath()+"/dang-nhap");
        else response.sendError(403);
        return;
    }
    try (MemberDAO accounts = new MemberDAO()) {
        signedInReader = accounts.getActiveById(signedInReader.getId());
    } catch (SQLException error) {
        application.log("Reader account access SQLState="+error.getSQLState());
        response.sendError(503, "Chưa thể kiểm tra tài khoản. Vui lòng thử lại."); return;
    }
    if (signedInReader == null) {
        session.invalidate(); response.sendRedirect(request.getContextPath()+"/dang-nhap"); return;
    }
    session.setAttribute("signedInMember", signedInReader);
    if (!"Reader".equals(signedInReader.getRole())) { response.sendError(403); return; }
%>
