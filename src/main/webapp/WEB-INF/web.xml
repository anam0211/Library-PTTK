<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0" metadata-complete="true">
    <display-name>LIBMAN - Tìm tài liệu</display-name>
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!-- Public aliases for JSP pages; there are no handwritten Servlet controllers. -->
    <servlet>
        <servlet-name>readerHome</servlet-name>
        <jsp-file>/WEB-INF/views/ReaderHome.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>readerHome</servlet-name>
        <url-pattern>/trang-chu</url-pattern>
        <url-pattern>/ban-doc</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>documentSearch</servlet-name>
        <jsp-file>/WEB-INF/views/DocumentSearch.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>documentSearch</servlet-name>
        <url-pattern>/tim-tai-lieu</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>documentDetails</servlet-name>
        <jsp-file>/WEB-INF/views/DocumentDetails.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>documentDetails</servlet-name>
        <url-pattern>/chi-tiet-tai-lieu</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>librarianHome</servlet-name>
        <jsp-file>/WEB-INF/views/LibrarianHome.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>librarianHome</servlet-name>
        <url-pattern>/nhan-vien</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>readerSearch</servlet-name>
        <jsp-file>/WEB-INF/views/SearchReader.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>readerSearch</servlet-name>
        <url-pattern>/tim-ban-doc</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>lendDocument</servlet-name>
        <jsp-file>/WEB-INF/views/LendDocument.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>lendDocument</servlet-name>
        <url-pattern>/cho-muon-tai-lieu</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>copySearch</servlet-name>
        <jsp-file>/WEB-INF/views/SearchDocumentCopy.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>copySearch</servlet-name>
        <url-pattern>/tim-ban-tai-lieu</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>loanSlip</servlet-name>
        <jsp-file>/WEB-INF/views/LoanSlip.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>loanSlip</servlet-name>
        <url-pattern>/phieu-muon</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>dangnhap</servlet-name>
        <jsp-file>/WEB-INF/views/Login.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>dangnhap</servlet-name>
        <url-pattern>/dang-nhap</url-pattern>
    </servlet-mapping>
<servlet>
        <servlet-name>dangxuat</servlet-name>
        <jsp-file>/WEB-INF/views/Logout.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>dangxuat</servlet-name>
        <url-pattern>/dang-xuat</url-pattern>
    </servlet-mapping>
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    <welcome-file-list>
        <welcome-file>trang-chu</welcome-file>
    </welcome-file-list>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/AccessDenied.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/khong-tim-thay.jsp</location>
    </error-page>
</web-app>
